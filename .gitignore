/submission.json
/audit.json
/verdict.json
/accuracy_report.json

# --- Python ---
venv/
.venv/
env/
.env
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store

