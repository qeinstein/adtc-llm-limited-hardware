+        __atomic_fetch_add(&phase4_fused_total_cycles, __rdtsc() - total_start, __ATOMIC_RELAXED);
+        __atomic_fetch_add(&phase4_fused_calls, 1, __ATOMIC_RELAXED);
+    }
