,{"stream_name":"stdout","time":9.349232087,"data":"+// Observation-only Phase-0 hook. Log IDs and packed tensor sizes for routed\n"}
,{"stream_name":"stdout","time":9.349236574,"data":"+// expert matmuls. This does not alter routing or math.\n"}
,{"stream_name":"stdout","time":9.349240599,"data":"+static void ggml_phase0_trace_moe_ids(\n"}
,{"stream_name":"stdout","time":9.349244249,"data":"+        const struct ggml_compute_params * params,\n"}
,{"stream_name":"stdout","time":9.34924777,"data":"+        const struct ggml_tensor * tensor) {\n"}
,{"stream_name":"stdout","time":9.349251661,"data":"+    if (params-\u003eith != 0 || tensor-\u003eop != GGML_OP_MUL_MAT_ID) {\n"}
,{"stream_name":"stdout","time":9.349255789,"data":"+        return;\n"}
,{"stream_name":"stdout","time":9.349259242,"data":"+    }\n"}
,{"stream_name":"stdout","time":9.349262692,"data":"+    const char * path = getenv(\"GGML_PHASE0_ROUTE_TRACE\");\n"}
,{"stream_name":"stdout","time":9.349266499,"data":"+    if (path == NULL || path[0] == '\\0') {\n"}
,{"stream_name":"stdout","time":9.349269968,"data":"+        return;\n"}
,{"stream_name":"stdout","time":9.349273429,"data":"+    }\n"}
,{"stream_name":"stdout","time":9.3492767,"data":"+    const struct ggml_tensor * weights = tensor-\u003esrc[0];\n"}
,{"stream_name":"stdout","time":9.349280298,"data":"+    const struct ggml_tensor * ids = tensor-\u003esrc[2];\n"}
,{"stream_name":"stdout","time":9.349283929,"data":"+    if (weights == NULL || ids == NULL ||\n"}
,{"stream_name":"stdout","time":9.349287624,"data":"+            strstr(weights-\u003ename, \"ffn_\") == NULL ||\n"}
,{"stream_name":"stdout","time":9.349291275,"data":"+            strstr(weights-\u003ename, \"_exps\") == NULL ||\n"}
,{"stream_name":"stdout","time":9.349295514,"data":"+            ids-\u003etype != GGML_TYPE_I32 || !ggml_is_contiguous(ids)) {\n"}
,{"stream_name":"stdout","time":9.349299472,"data":"+        return;\n"}
,{"stream_name":"stdout","time":9.349302968,"data":"+    }\n"}
,{"stream_name":"stdout","time":9.349306339,"data":"+    static FILE * fp = NULL;\n"}
,{"stream_name":"stdout","time":9.349310012,"data":"+    static uint64_t event_id = 0;\n"}
,{"stream_name":"stdout","time":9.349313668,"data":"+    if (fp == NULL) {\n"}
,{"stream_name":"stdout","time":9.34931699,"data":"+        fp = fopen(path, \"a\");\n"}
,{"stream_name":"stdout","time":9.349320792,"data":"+        if (fp == NULL) {\n"}
,{"stream_name":"stdout","time":9.349324712,"data":"+            return;\n"}
,{"stream_name":"stdout","time":9.349328557,"data":"+        }\n"}
,{"stream_name":"stdout","time":9.34933183,"data":"+        setvbuf(fp, NULL, _IOLBF, 0);\n"}
,{"stream_name":"stdout","time":9.349335317,"data":"+    }\n"}
,{"stream_name":"stdout","time":9.349338795,"data":"+    struct timespec ts;\n"}
,{"stream_name":"stdout","time":9.349342857,"data":"+    clock_gettime(CLOCK_MONOTONIC, \u0026ts);\n"}
,{"stream_name":"stdout","time":9.349346827,"data":"+    const int64_t n = ggml_nelements(ids);\n"}
,{"stream_name":"stdout","time":9.349350557,"data":"+    const int32_t * values = (const int32_t *) ids-\u003edata;\n"}
,{"stream_name":"stdout","time":9.349358953,"data":"+    fprintf(fp,\n"}
,{"stream_name":"stdout","time":9.349362607,"data":"+        \"{\\\"event\\\":%\" PRIu64 \",\\\"mono_ns\\\":%\" PRIu64\n"}
,{"stream_name":"stdout","time":9.349366755,"data":"+        \",\\\"weight\\\":\\\"%s\\\",\\\"weight_nbytes\\\":%zu,\\\"shape\\\":[%\" PRId64 \",%\" PRId64\n"}
,{"stream_name":"stdout","time":9.34937094,"data":"+        \",%\" PRId64 \",%\" PRId64 \"],\\\"ids\\\":[\",\n"}
,{"stream_name":"stdout","time":9.349374821,"data":"+        event_id++, (uint64_t) ts.tv_sec*1000000000ULL + (uint64_t) ts.tv_nsec,\n"}
,{"stream_name":"stdout","time":9.349378783,"data":"+        weights-\u003ename, ggml_nbytes(weights), ids-\u003ene[0], ids-\u003ene[1], ids-\u003ene[2], ids-\u003ene[3]);\n"}
,{"stream_name":"stdout","time":9.349382805,"data":"+    for (int64_t i = 0; i \u003c n; ++i) {\n"}
,{"stream_name":"stdout","time":9.349386385,"data":"+        fprintf(fp, \"%s%d\", i ? \",\" : \"\", values[i]);\n"}
,{"stream_name":"stdout","time":9.349390552,"data":"+    }\n"}
,{"stream_name":"stdout","time":9.349393849,"data":"+    fprintf(fp, \"]}\\n\");\n"}
,{"stream_name":"stdout","time":9.349397682,"data":"+}\n"}
