,{"stream_name":"stdout","time":10.82086593,"data":"+// Observation-only Phase-0 hook. Log IDs and packed tensor sizes for routed\n"}
,{"stream_name":"stdout","time":10.820869512,"data":"+// expert matmuls. This does not alter routing or math.\n"}
,{"stream_name":"stdout","time":10.820873158,"data":"+static void ggml_phase0_trace_moe_ids(\n"}
,{"stream_name":"stdout","time":10.820876786,"data":"+        const struct ggml_compute_params * params,\n"}
,{"stream_name":"stdout","time":10.820880605,"data":"+        const struct ggml_tensor * tensor) {\n"}
,{"stream_name":"stdout","time":10.820883911,"data":"+    if (params-\u003eith != 0 || tensor-\u003eop != GGML_OP_MUL_MAT_ID) {\n"}
,{"stream_name":"stdout","time":10.820887917,"data":"+        return;\n"}
,{"stream_name":"stdout","time":10.820891348,"data":"+    }\n"}
,{"stream_name":"stdout","time":10.820895124,"data":"+    const char * path = getenv(\"GGML_PHASE0_ROUTE_TRACE\");\n"}
,{"stream_name":"stdout","time":10.820898781,"data":"+    if (path == NULL || path[0] == '\\0') {\n"}
,{"stream_name":"stdout","time":10.820902557,"data":"+        return;\n"}
,{"stream_name":"stdout","time":10.820906003,"data":"+    }\n"}
,{"stream_name":"stdout","time":10.820909559,"data":"+    const struct ggml_tensor * weights = tensor-\u003esrc[0];\n"}
,{"stream_name":"stdout","time":10.820913829,"data":"+    const struct ggml_tensor * ids = tensor-\u003esrc[2];\n"}
,{"stream_name":"stdout","time":10.820918129,"data":"+    if (weights == NULL || ids == NULL ||\n"}
,{"stream_name":"stdout","time":10.820922279,"data":"+            strstr(weights-\u003ename, \"ffn_\") == NULL ||\n"}
,{"stream_name":"stdout","time":10.820926384,"data":"+            strstr(weights-\u003ename, \"_exps\") == NULL ||\n"}
,{"stream_name":"stdout","time":10.820930488,"data":"+            ids-\u003etype != GGML_TYPE_I32 || !ggml_is_contiguous(ids)) {\n"}
,{"stream_name":"stdout","time":10.820934886,"data":"+        return;\n"}
,{"stream_name":"stdout","time":10.82093855,"data":"+    }\n"}
,{"stream_name":"stdout","time":10.82094229,"data":"+    static FILE * fp = NULL;\n"}
,{"stream_name":"stdout","time":10.820946327,"data":"+    static uint64_t event_id = 0;\n"}
,{"stream_name":"stdout","time":10.820950168,"data":"+    if (fp == NULL) {\n"}
,{"stream_name":"stdout","time":10.820953684,"data":"+        fp = fopen(path, \"a\");\n"}
,{"stream_name":"stdout","time":10.82095714,"data":"+        if (fp == NULL) {\n"}
,{"stream_name":"stdout","time":10.820961216,"data":"+            return;\n"}
,{"stream_name":"stdout","time":10.820964759,"data":"+        }\n"}
,{"stream_name":"stdout","time":10.820968241,"data":"+        setvbuf(fp, NULL, _IOLBF, 0);\n"}
,{"stream_name":"stdout","time":10.820972016,"data":"+    }\n"}
,{"stream_name":"stdout","time":10.820975411,"data":"+    struct timespec ts;\n"}
,{"stream_name":"stdout","time":10.820978584,"data":"+    clock_gettime(CLOCK_MONOTONIC, \u0026ts);\n"}
,{"stream_name":"stdout","time":10.820982306,"data":"+    const int64_t n = ggml_nelements(ids);\n"}
,{"stream_name":"stdout","time":10.820985884,"data":"+    const int32_t * values = (const int32_t *) ids-\u003edata;\n"}
,{"stream_name":"stdout","time":10.820994176,"data":"+    fprintf(fp,\n"}
,{"stream_name":"stdout","time":10.820998516,"data":"+        \"{\\\"event\\\":%\" PRIu64 \",\\\"mono_ns\\\":%\" PRIu64\n"}
,{"stream_name":"stdout","time":10.821002805,"data":"+        \",\\\"weight\\\":\\\"%s\\\",\\\"weight_nbytes\\\":%zu,\\\"shape\\\":[%\" PRId64 \",%\" PRId64\n"}
,{"stream_name":"stdout","time":10.821007349,"data":"+        \",%\" PRId64 \",%\" PRId64 \"],\\\"ids\\\":[\",\n"}
,{"stream_name":"stdout","time":10.821011476,"data":"+        event_id++, (uint64_t) ts.tv_sec*1000000000ULL + (uint64_t) ts.tv_nsec,\n"}
,{"stream_name":"stdout","time":10.821015251,"data":"+        weights-\u003ename, ggml_nbytes(weights), ids-\u003ene[0], ids-\u003ene[1], ids-\u003ene[2], ids-\u003ene[3]);\n"}
,{"stream_name":"stdout","time":10.821019322,"data":"+    for (int64_t i = 0; i \u003c n; ++i) {\n"}
,{"stream_name":"stdout","time":10.821022824,"data":"+        fprintf(fp, \"%s%d\", i ? \",\" : \"\", values[i]);\n"}
,{"stream_name":"stdout","time":10.821027276,"data":"+    }\n"}
,{"stream_name":"stdout","time":10.821031052,"data":"+    fprintf(fp, \"]}\\n\");\n"}
,{"stream_name":"stdout","time":10.821035253,"data":"+}\n"}
,{"stream_name":"stdout","time":10.821038646,"data":"+\n"}
