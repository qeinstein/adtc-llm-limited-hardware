+static bool phase3_profile_enabled() {
+    const char * value = getenv("GGML_PHASE3_PROFILE");
+    return value != nullptr && atoi(value) != 0;
+}
+
+#if defined(__x86_64__) || defined(_M_X64)
+static inline uint64_t phase3_tsc() { return __rdtsc(); }
+#else
+static inline uint64_t phase3_tsc() { return 0; }
+#endif
+
+static std::atomic<uint64_t> phase3_decode_cycles{0};
+static std::atomic<uint64_t> phase3_gemv_cycles{0};
+static std::atomic<uint64_t> phase3_decode_calls{0};
+static std::atomic<uint64_t> phase3_gemv_calls{0};
+static void phase3_report() {
+    if (phase3_profile_enabled()) {
+        fprintf(stderr, "PHASE3_IQP_PROFILE decode_cycles=%llu gemv_cycles=%llu decode_calls=%llu gemv_calls=%llu\n",
+            (unsigned long long) phase3_decode_cycles.load(),
+            (unsigned long long) phase3_gemv_cycles.load(),
+            (unsigned long long) phase3_decode_calls.load(),
+            (unsigned long long) phase3_gemv_calls.load());
+    }
+}
+
+static bool phase3_report_registered = []() {
+    if (phase3_profile_enabled()) { atexit(phase3_report); }
+    return true;
+}();
